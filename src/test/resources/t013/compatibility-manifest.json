  "knownDifferences": [
    {
      "difference": "No binary protocol",
      "reason": "Release 1.0 scope limit",
      "status": "P3"
    },
    {
      "difference": "No meta commands (mg, ms, md, ma)",
      "reason": "Release 1.0 scope limit",
      "status": "P2"
    },
    {
      "difference": "No stats sizes, stats conns, stats cachedump",
      "reason": "Rarely used; accounting cost",
      "status": "P2"
    },
    {
      "difference": "No UDP",
      "reason": "Simplification and safety",
      "status": "P2 on request"
    },
    {
      "difference": "No SASL",
      "reason": "Matches default Memcached behavior; security is network-level",
      "status": "P2"
    },
    {
      "difference": "No non-standard watch, lru_crawler, cache_memlimit, shutdown",
      "reason": "Administrative commands outside the protocol",
      "status": "not planned"
    },
    {
      "difference": "Repeated keys in get are emitted once",
      "reason": "Defined in docs/04 section 3.4",
      "status": "known difference"
    },
    {
      "difference": "Legacy delete <time> argument is accepted and ignored",
      "reason": "Compatibility with old clients",
      "status": "known difference"
    },
    {
      "difference": "Single LF accepted as line terminator",
      "reason": "Robustness for non-standard clients",
      "status": "known difference"
    },
    {
      "difference": "Command line length limit (default 8192 bytes)",
      "reason": "Overload protection",
      "status": "known difference; configurable"
    },
    {
      "difference": "version string contains the octomem marker",
      "reason": "Honest provenance",
